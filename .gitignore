# 密钥/配置：只存在 %APPDATA%\DshShot\config.ini，任何情况下都不进仓库
config.ini
*.ini
# 价目表是公开示例，需要进仓库
!pricing.ini
*.key
*.env
secrets*

# 快捷方式由 install.ps1 在本机生成，不进仓库（里面有绝对路径)
*.lnk

# 旧版备份 / 编译中间产物
*.bak-*
*.pdb
*.obj
# 编译产物由 build.ps1 / CI 生成，不再进仓库
DshShot.dll
tests/bin/

# 日志与临时文件
*.log
*.tmp
*.user

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store
